{# =========================================================================
   Site Tint settings
   Per-site control panel color themes: a preview-site switcher, and for
   each non-primary site a preset gallery, live mockup, and grouped color
   fields (sidebar / header / content / controls).
   ========================================================================= #}

{# @var plugin \transom\craftsitetint\SiteTint #}
{# @var settings \transom\craftsitetint\models\Settings #}
{# @var sites craft\models\Site[] #}
{# @var siteThemes array #}
{# @var presets array #}
{# @var groups array #}

{% import '_includes/forms.twig' as forms %}
{% do view.registerAssetBundle('transom\\craftsitetint\\assets\\settings\\SettingsAsset') %}

{% set siteParam = craft.app.request.getParam('site') %}
{% set allSitesForSwitcher = craft.app.sites.getAllSites() %}
{% set currentSite = siteParam ? craft.app.sites.getSiteByHandle(siteParam) : craft.app.sites.getCurrentSite() %}
{% set currentSite = currentSite ?: craft.app.sites.getPrimarySite() %}

{{ forms.selectField({
    label: 'Preview site'|t('site-tint'),
    instructions: 'Switch the site context to preview the control panel tint for that site.'|t('site-tint'),
    id: 'site-tint-site-switcher',
    name: 'site',
    value: currentSite ? currentSite.handle : null,
    options: allSitesForSwitcher|map(site => { label: site.name, value: site.handle }),
    inputAttributes: {
        data: {
            'site-tint-switcher': true,
        },
    },
}) }}

{% js %}
(() => {
  const handleChange = (value) => {
    if (!value) return;
    if (window.Craft && typeof Craft.getUrlWithParams === 'function') {
      window.location.assign(Craft.getUrlWithParams(window.location.href, { site: value }));
      return;
    }
    const url = new URL(window.location.href);
    url.searchParams.set('site', value);
    window.location.assign(url.toString());
  };

  const onChange = (event) => {
    const target = event.target;
    if (!target || !target.matches('[data-site-tint-switcher]')) return;
    handleChange(target.value);
  };

  const init = () => {
    document.addEventListener('change', onChange);
  };

  if (window.Garnish && Garnish.$doc) {
    Garnish.$doc.ready(init);
  } else if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
{% endjs %}

<hr>

{% for site in sites %}
    {% set theme = siteThemes[site.uid] ?? {} %}
    <div class="pane st-site" data-st-site="{{ site.uid }}">
        <div class="st-site__header">
            <h2>{{ site.name }}</h2>
            <span class="light">{{ site.handle }}</span>
            <div class="st-strip" data-st-strip>
                {% for group in ['sidebar', 'header', 'content', 'controls'] %}
                    {% set color = theme[group].bg ?? theme[group].accent ?? 'transparent' %}
                    <span style="background-color: {{ color }}"></span>
                {% endfor %}
            </div>
            <button type="button" class="btn" data-st-reset>{{ 'Revert to native'|t('site-tint') }}</button>
        </div>

        <p class="st-hint hidden" data-st-hint></p>

        <h3>{{ 'Presets'|t('site-tint') }}</h3>
        <div class="st-presets">
            {% for handle, preset in presets %}
                {% set presetTheme = preset.theme %}
                <button type="button" class="st-preset" data-st-preset="{{ presetTheme|json_encode }}">
                    <span class="st-preset__mock">
                        <span class="st-preset__mock-sidebar" style="background-color: {{ presetTheme.sidebar.bg ?? '' }}"></span>
                        <span class="st-preset__mock-header" style="background-color: {{ presetTheme.header.bg ?? '' }}"></span>
                        <span class="st-preset__mock-content" style="background-color: {{ presetTheme.content.bg ?? '' }}">
                            <span class="st-preset__mock-btn" style="background-color: {{ presetTheme.controls.accent ?? '' }}"></span>
                        </span>
                    </span>
                    <span class="st-preset__name">{{ preset.name }}</span>
                </button>
            {% endfor %}
        </div>

        <h3>{{ 'Live preview'|t('site-tint') }}</h3>
        <div class="st-mockup" aria-hidden="true">
            <div class="st-mockup__sidebar">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <div class="st-mockup__header">
                <span></span>
            </div>
            <div class="st-mockup__content">
                <div class="st-mockup__pane"></div>
                <div class="st-mockup__btn"></div>
            </div>
        </div>

        {% for groupHandle, group in groups %}
            <fieldset class="st-group">
                <legend>{{ group.label }}</legend>
                <div class="flex flex-wrap st-grid">
                    {% for key, label in group.fields %}
                        {% set fieldId = "st-#{site.uid}-#{groupHandle}-#{key}" %}
                        <div class="field st-field-wrap" data-st-field="{{ groupHandle }}.{{ key }}">
                            <div class="heading">
                                <label for="{{ fieldId }}">{{ label }}</label>
                            </div>
                            <div class="input">
                                {{ forms.color({
                                    id: fieldId,
                                    name: "themes[#{site.uid}][#{groupHandle}][#{key}]",
                                    value: theme[groupHandle][key] ?? '',
                                    small: true,
                                }) }}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </fieldset>
        {% endfor %}
    </div>
{% endfor %}
